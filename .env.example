# Copiez ce fichier en .env.local et remplissez les valeurs.
# Sans DATABASE_URL, le développement utilise une base embarquée dans .data/.
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM="ClipBoost <no-reply@clipboost.dz>"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresse publique du site, sans / final (ex. https://clipboost.dz) : adresses de retour des connexions Google, Apple et Discord.
# Vide : origine de la requête (suffisant en local, à définir en production derrière un proxy).
APP_URL=

# Connexion avec Google, Apple ou Discord (facultatif) : un bouton n'apparaît que si toutes les variables de son fournisseur sont définies.
# Adresse de retour à déclarer chez le fournisseur : ${APP_URL}/api/auth/oauth/<google|apple|discord>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Apple : Services ID, identifiant d'équipe, identifiant de la clé, contenu de la clé .p8 (retours à la ligne écrits \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Vérification des comptes sociaux des clippers (code « CB-XXXX » lu dans la bio par l'API officielle de chaque plateforme)
# et relevé automatique des vues de leurs clips (toutes les 6 heures, mêmes clés).
# Une plateforme sans toutes ses variables est en mode simulé : la vérification réussit sans rien lire et les vues suivent
# une croissance simulée (développement, démonstration). En production, renseignez-les toutes, sinon n'importe quel
# compte peut être déclaré vérifié.
# YouTube : clé de l'API YouTube Data v3 (Google Cloud Console → API et services → Identifiants).
YOUTUBE_API_KEY=
# Instagram : jeton de la Graph API de Meta et identifiant du compte Instagram professionnel qui interroge la Business Discovery.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Facebook : jeton de la Graph API de Meta (lecture des pages publiques : accès « Page Public Metadata Access »).
FACEBOOK_ACCESS_TOKEN=
# TikTok : clé et secret d'une application TikTok ayant accès à l'API Research (jeton « client credentials »).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Relevé automatique des vues toutes les 6 heures : la tâche planifiée (Vercel Cron, vercel.json) appelle GET /api/cron/views
# avec l'en-tête « Authorization: Bearer <CRON_SECRET> ». Obligatoire en production (sans lui, la route est refusée) ;
# une longue valeur aléatoire, par exemple : openssl rand -hex 32. Hors Vercel : npm run cron:views dans une crontab.
CRON_SECRET=
