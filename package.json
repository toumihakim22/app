{
  "name": "clipper-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node web/build.mjs && next dev",
    "build": "node web/build.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:seed:demo": "tsx scripts/seed.mts --demo",
    "test": "tsx --test tests/*.test.ts",
    "build:app": "node web/build.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-orm": "^0.45.4",
    "next": "^15.2.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
